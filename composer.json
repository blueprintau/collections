{
    "name": "blueprintau/collections",
    "description": "A pure, standalone array wrapper for BlueprintAU — generic Collection and Enumerable contract with no dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "collection",
        "array",
        "enumerable",
        "blueprintau"
    ],
    "support": {
        "issues": "https://github.com/blueprintau/collections/issues",
        "source": "https://github.com/blueprintau/collections"
    },
    "authors": [
        {
            "name": "Mineubob"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "BlueprintAU\\Collections\\": "src/"
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BlueprintAU\\Collections\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "coverage:check": "phpunit --coverage-clover coverage-report/coverage.xml && php ci/coverage-threshold.php",
        "security:audit": "composer audit --locked"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "prefer-stable": true
    },
    "minimum-stability": "stable"
}
