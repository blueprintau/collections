{
    "name": "blueprintau/collections",
    "description": "A pure, standalone array wrapper for BlueprintAU — generic Collection and Enumerable contract with no dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "collection",
        "array",
        "enumerable",
        "blueprintau"
    ],
    "support": {
        "issues": "https://github.com/blueprintau/collections/issues",
        "source": "https://github.com/blueprintau/collections"
    },
    "authors": [
        {
            "name": "Mineubob"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BlueprintAU\\Collections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlueprintAU\\Collections\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}